{
  "ConnectionStrings": {
    "MySql": "Server=localhost;Port=3306;Database=rezerv;User=rezerv;Password=rezerv;"
  },
  "Database": {
    "ServerVersion": "8.0.36",
    "SeedOnStartup": true
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "KeyPrefix": "rezerv:",
    "LockTtlMs": 10000,
    "LockWaitMs": 5000,
    "LockRetryMs": 25
  },
  "Jobs": {
    "Enabled": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Hangfire": "Warning"
    }
  },
  "AllowedHosts": "*"
}
